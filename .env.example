# Required server-side secret for Groq AI features.
GROQ_API_KEY=

# Optional Groq model overrides.
GROQ_TUTOR_MODEL=openai/gpt-oss-120b
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_SECONDARY_MODEL=openai/gpt-oss-20b

# Supabase personalized accounts.
# VITE_* values are public project configuration and are safe for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side equivalents used to authenticate personalized ArthaMind requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose this value through VITE_* or frontend code.
# Required only for permanent account deletion through /api/account/delete.
SUPABASE_SERVICE_ROLE_KEY=

# Business news.
BUSINESS_NEWS_PROVIDER=newsdata
BUSINESS_NEWS_API_KEY=
BUSINESS_NEWS_BASE_URL=https://newsdata.io/api/1/latest

# Market-data adapter.
# `hybrid` keeps the existing Yahoo experimental/reference path and can use a
# verified Twelve Data mapping as fallback. `twelve_data` is strict and never
# assumes Yahoo .NS/.BO symbols or silently falls back when configuration fails.
MARKET_DATA_PROVIDER=hybrid
MARKET_DATA_PRIMARY_PROVIDER=yahoo
MARKET_DATA_FALLBACK_PROVIDER=twelvedata
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart

# Preferred dedicated Twelve Data server-only configuration.
# Never expose TWELVE_DATA_API_KEY through VITE_*, NEXT_PUBLIC_*, logs, UI, tests, or API responses.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Verified/batch market adapter settings.
MARKET_DATA_BATCH_QUOTE_ENDPOINT=
MARKET_DATA_INDIA_SEARCH_ENDPOINT=
MARKET_DATA_SEARCH_ENDPOINT=
MARKET_DATA_HISTORY_ENDPOINT=
MARKET_DATA_COMPANY_PROFILE_ENDPOINT=
MARKET_DATA_FRESHNESS_MINUTES=
MARKET_DATA_CACHE_TTL_SECONDS=60
MARKET_DATA_STALE_THRESHOLD_MINUTES=10
MARKET_DATA_REQUEST_TIMEOUT_MS=8000
MARKET_LOGO_PROVIDER=
MARKET_LOGO_API_KEY=

# Future dedicated Forex provider. No UI claims streaming/bid/ask support unless these adapters are truly configured.
FOREX_DATA_PROVIDER=
FOREX_DATA_API_KEY=
FOREX_DATA_BASE_URL=
FOREX_DATA_WEBSOCKET_URL=
FOREX_DATA_FRESHNESS_MINUTES=
FOREX_DATA_CACHE_TTL_SECONDS=
FOREX_DATA_STALE_THRESHOLD_MINUTES=

# Future licensed/authorised India intraday feed. Keep INDIA_INTRADAY_LICENSED=false until entitlement is actually verified.
INDIA_INTRADAY_PROVIDER=
INDIA_INTRADAY_API_KEY=
INDIA_INTRADAY_BASE_URL=
INDIA_INTRADAY_WEBSOCKET_URL=
INDIA_INTRADAY_LICENSED=false

# Future consented finance-data integrations. No current UI claims these are connected.
ACCOUNT_AGGREGATION_PROVIDER=
ACCOUNT_AGGREGATION_BASE_URL=
ACCOUNT_AGGREGATION_CLIENT_ID=
ACCOUNT_AGGREGATION_CLIENT_SECRET=
LOAN_DOCUMENT_EXTRACTION_PROVIDER=
LOAN_DOCUMENT_EXTRACTION_API_KEY=
RBI_POLICY_RATE_PROVIDER=
LENDER_RATE_PROVIDER=
LENDER_RATE_API_KEY=
FX_RATE_PROVIDER=
FX_RATE_API_KEY=

# Future notification delivery. Browser permission alone does not mean external/background delivery is configured.
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=

# Future subscription/billing backend. These values are server-side only and are intentionally blank.
SUBSCRIPTION_PROVIDER=
SUBSCRIPTION_SECRET_KEY=
SUBSCRIPTION_PRICE_ID=
SUBSCRIPTION_WEBHOOK_SECRET=

# Public app-environment labels only; never put provider or payment secrets in public variables.
VITE_APP_ENV=
NEXT_PUBLIC_APP_ENV=

# US economic data.
FRED_API_KEY=
FRED_API_BASE_URL=https://api.stlouisfed.org/fred/series/observations
FRED_CSV_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv

# Optional company-intelligence provider.
FINNHUB_API_KEY=
