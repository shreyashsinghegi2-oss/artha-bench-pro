# Required server-side secret for Groq AI features.
GROQ_API_KEY=

# Optional Groq model overrides.
GROQ_TUTOR_MODEL=openai/gpt-oss-120b
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_SECONDARY_MODEL=openai/gpt-oss-20b

# Supabase personalized accounts.
# VITE_* values are public project configuration and are safe for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side equivalents used to authenticate personalized ArthaMind requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose this value through VITE_* or frontend code.
# Required only for permanent account deletion through /api/account/delete.
SUPABASE_SERVICE_ROLE_KEY=

# Business news.
# NewsData.io is preferred when configured. If its key is missing or the request
# fails, production falls back to current Google News RSS headlines. No fixture
# headlines are substituted.
BUSINESS_NEWS_PROVIDER=newsdata
BUSINESS_NEWS_API_KEY=
BUSINESS_NEWS_BASE_URL=https://newsdata.io/api/1/latest

# Market data.
# Real-provider-first default: Yahoo Finance server adapter first; Twelve Data
# second only when MARKET_DATA_API_KEY is configured. Provider freshness is
# preserved as real_time / delayed / end_of_day / stale; demo values are never
# used as production fallbacks.
MARKET_DATA_PROVIDER=hybrid
MARKET_DATA_PRIMARY_PROVIDER=yahoo
MARKET_DATA_FALLBACK_PROVIDER=twelvedata
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com/quote
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart

# US economic data.
# FRED_API_KEY is optional: when absent, the server reads the same official FRED
# series through FRED's public CSV endpoint. These are latest official releases,
# not tick-by-tick market values.
FRED_API_KEY=
FRED_API_BASE_URL=https://api.stlouisfed.org/fred/series/observations
FRED_CSV_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv

# Optional company-intelligence provider.
FINNHUB_API_KEY=
