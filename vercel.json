{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    { "source": "/finance/:path*", "destination": "/index.html" },
    { "source": "/workspace/:path*", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/trust", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/methodology", "destination": "/index.html" },
    { "source": "/roadmap", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/changelog", "destination": "/index.html" },
    { "source": "/access", "destination": "/index.html" },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
